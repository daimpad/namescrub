# NameScrub — Apache-Konfiguration für Plesk
# Zieldomain: namescrub.nozilla.net

# Zeichenkodierung
AddDefaultCharset UTF-8

# Komprimierung (gzip) für Text-Assets
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Browser-Caching
<IfModule mod_expires.c>
  ExpiresActive On
  # Vite erzeugt gehashte Dateinamen → langes Caching für Assets
  <FilesMatch "\.(js|css|woff2?)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  # dictionary.json ist groß und ändert sich selten
  <FilesMatch "dictionary\.json$">
    ExpiresDefault "access plus 7 days"
  </FilesMatch>
  # HTML nie cachen (damit Updates sofort sichtbar sind)
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# MIME-Typen für moderne Web-Assets
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/json .json
  AddType font/woff2 .woff2
</IfModule>

# Security-Header
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  # Strikte CSP: keine externen Skripte außer Google Fonts
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self';"
</IfModule>

# SPA-Fallback: alle Routen auf index.html leiten (falls später Routing hinzukommt)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Assets (JS, CSS, JSON, Fonts, Images) niemals umleiten — verhindert MIME-Type-Fehler
  RewriteCond %{REQUEST_URI} \.(js|mjs|css|json|woff2?|png|svg|ico|webmanifest)$ [NC]
  RewriteRule ^ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
